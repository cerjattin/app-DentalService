  appointmentNumber  String                     @map("appointment_number") @db.VarChar(50)
  patientId          BigInt                     @map("patient_id") @db.UnsignedBigInt
  providerId         BigInt                     @map("provider_id") @db.UnsignedBigInt
  clinicLocationId   BigInt                     @map("clinic_location_id") @db.UnsignedBigInt
  treatmentCaseId    BigInt?                    @map("treatment_case_id") @db.UnsignedBigInt
  accidentCaseId     BigInt?                    @map("accident_case_id") @db.UnsignedBigInt
  scheduledStartAt   DateTime                   @map("scheduled_start_at")
  scheduledEndAt     DateTime                   @map("scheduled_end_at")
  status             AppointmentStatus          @default(SCHEDULED)
  reason             String?                    @db.VarChar(255)
  notes              String?                    @db.Text
  createdByUserId    BigInt                     @map("created_by_user_id") @db.UnsignedBigInt
  checkedInAt        DateTime?                  @map("checked_in_at")
  startedAt          DateTime?                  @map("started_at")
  completedAt        DateTime?                  @map("completed_at")
  cancelledAt        DateTime?                  @map("cancelled_at")
  cancellationReason String?                    @map("cancellation_reason") @db.VarChar(500)
  createdAt          DateTime                   @default(now()) @map("created_at")
  updatedAt          DateTime                   @default(now()) @map("updated_at")
  statusHistory      AppointmentStatusHistory[]
  accidentCase       AccidentCase?              @relation(fields: [accidentCaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_appointments_accident")
  createdByUser      User                       @relation(fields: [createdByUserId], references: [id], onUpdate: Restrict, map: "fk_appointments_created_by")
  clinicLocation     ClinicLocation             @relation(fields: [clinicLocationId], references: [id], onUpdate: Restrict, map: "fk_appointments_location")
  organization       Organization               @relation(fields: [organizationId], references: [id], onUpdate: Restrict, map: "fk_appointments_organization")
  patient            Patient                    @relation(fields: [patientId], references: [id], onUpdate: Restrict, map: "fk_appointments_patient")
  provider           Provider                   @relation(fields: [providerId], references: [id], onUpdate: Restrict, map: "fk_appointments_provider")
  treatmentCase      TreatmentCase?             @relation(fields: [treatmentCaseId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_appointments_treatment")
  clinicalEncounter  ClinicalEncounter?
  invoice            Invoice?

  @@unique([organizationId, appointmentNumber], map: "uq_appointments_org_number")
  @@index([accidentCaseId], map: "fk_appointments_accident")
  @@index([createdByUserId], map: "fk_appointments_created_by")
  @@index([clinicLocationId], map: "fk_appointments_location")
  @@index([treatmentCaseId], map: "fk_appointments_treatment")
  @@index([patientId, scheduledStartAt], map: "idx_appointments_patient_time")
  @@index([providerId, scheduledStartAt, scheduledEndAt], map: "idx_appointments_provider_time")
  @@index([status, scheduledStartAt], map: "idx_appointments_status_time")
  @@map("appointments")
}

