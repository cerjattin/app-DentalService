generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model AccidentCase {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  patientId          BigInt             @map("patient_id") @db.UnsignedBigInt
  patientInsuranceId BigInt?            @map("patient_insurance_id") @db.UnsignedBigInt
  accidentFormNumber String             @map("accident_form_number") @db.VarChar(80)
  accidentDate       DateTime?          @map("accident_date") @db.Date
  description        String?            @db.Text
  status             AccidentCaseStatus @default(OPEN)
  createdByUserId    BigInt             @map("created_by_user_id") @db.UnsignedBigInt
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @map("updated_at")
  createdByUser      User               @relation(fields: [createdByUserId], references: [id], onUpdate: Restrict, map: "fk_accident_created_by")
  patientInsurance   PatientInsurance?  @relation(fields: [patientInsuranceId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "fk_accident_insurance")
  patient            Patient            @relation(fields: [patientId], references: [id], onUpdate: Restrict, map: "fk_accident_patient")
  appointments       Appointment[]

  @@unique([patientId, accidentFormNumber], map: "uq_accident_patient_form")
  @@index([createdByUserId], map: "fk_accident_created_by")
  @@index([patientInsuranceId], map: "fk_accident_insurance")
  @@index([patientId, status], map: "idx_accident_patient_status")
  @@map("accident_cases")
}

model AppointmentStatusHistory {
  id              BigInt                             @id @default(autoincrement()) @db.UnsignedBigInt
  appointmentId   BigInt                             @map("appointment_id") @db.UnsignedBigInt
  oldStatus       AppointmentStatusHistoryOldStatus? @map("old_status")
  newStatus       AppointmentStatusHistoryNewStatus  @map("new_status")
  reason          String?                            @db.VarChar(500)
  changedByUserId BigInt                             @map("changed_by_user_id") @db.UnsignedBigInt
  changedAt       DateTime                           @default(now()) @map("changed_at")
  metadata        Json?
  appointment     Appointment                        @relation(fields: [appointmentId], references: [id], onUpdate: Restrict, map: "fk_appointment_history_appointment")
  changedByUser   User                               @relation(fields: [changedByUserId], references: [id], onUpdate: Restrict, map: "fk_appointment_history_user")

  @@index([changedByUserId], map: "fk_appointment_history_user")
  @@index([appointmentId, changedAt], map: "idx_appointment_history_appt_time")
  @@map("appointment_status_history")
}

