NODE_ENV=development

HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgresql://postgres:LOCAL_TEST_PASSWORD@127.0.0.1:5432/odontho_test

APP_TIMEZONE=America/Curacao

# First clinical deployment: SVB presentations deferred. Keep false.
# true is allowed ONLY in NODE_ENV=test with local PostgreSQL ending in _test.
SVB_MANUAL_RECORDING_ENABLED=false

LOG_LEVEL=debug

ACCESS_TOKEN_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
ACCESS_TOKEN_TTL=15m

JWT_ISSUER=odontho-svb-backend
JWT_AUDIENCE=odontho-svb-web

AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCK_MINUTES=15
AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=60000
AUTH_LOGIN_RATE_LIMIT_MAX=20

REFRESH_TOKEN_TTL_DAYS=7

CORS_ORIGIN=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

OPENAPI_ENABLED=true

DOCUMENT_STORAGE_PATH=storage/documents
DOCUMENT_MAX_UPLOAD_BYTES=5242880

# Persistent host: LOCAL with backup/restore of DB and DOCUMENT_STORAGE_PATH.
# Vercel: SUPABASE required; configure a pre-existing PRIVATE bucket and HTTPS CORS.
DOCUMENT_STORAGE_PROVIDER=LOCAL
# SUPABASE_URL=https://PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_SECRET_DO_NOT_PREFIX_WITH_VITE
# SUPABASE_STORAGE_BUCKET=clinical-documents
# DOCUMENT_MAX_UPLOAD_BYTES=4194304
