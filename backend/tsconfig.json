{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],

    "module": "NodeNext",
    "moduleResolution": "NodeNext",

    "rootDir": ".",
    "outDir": "dist",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    "esModuleInterop": true,
    "resolveJsonModule": true,

    "sourceMap": true,
    "declaration": false,

    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "prisma.config.ts"],
  "exclude": ["node_modules", "dist"]
}
